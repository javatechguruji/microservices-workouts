# Public browser configuration only. Never put a client secret in VITE_* variables.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=ecommerce
VITE_KEYCLOAK_CLIENT_ID=security-demo-ui
# Used only by the Vite server to forward API calls to the gateway.
GATEWAY_PROXY_TARGET=http://localhost:9100
